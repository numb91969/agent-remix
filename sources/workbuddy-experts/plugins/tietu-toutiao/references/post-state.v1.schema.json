{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tietu-post.v1",
  "type": "object",
  "required": ["schema_version", "post_id", "revision_id", "audience", "profile", "title", "caption", "tags", "brand", "sources", "cards", "order"],
  "properties": {
    "schema_version": {"const": "tietu-post.v1"},
    "post_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "revision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "parent_revision_id": {"type": ["string", "null"]},
    "audience": {"enum": ["media", "creator"]},
    "profile": {"enum": ["portrait", "square", "legacy"]},
    "title": {"type": "string", "minLength": 1},
    "caption": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "brand": {"type": "object", "required": ["name", "ink", "accent", "paper"], "properties": {"name": {"type": "string"}, "ink": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "paper": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "path", "sha256", "label"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "label": {"type": "string", "minLength": 1}}}},
    "cards": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "object", "required": ["id", "kind", "title", "text", "credit", "source_refs"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["photo", "text", "legacy"]}, "title": {"type": "string"}, "text": {"type": "string"}, "credit": {"type": "string"}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "photo": {"type": "object", "required": ["source_id"], "properties": {"source_id": {"type": "string"}, "crop": {"type": "object", "required": ["x", "y", "width", "height"]}, "focal_point": {"type": "object", "required": ["x", "y"]}}}}}},
    "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "locks": {"type": "array", "items": {"type": "string"}},
    "reviews": {"type": "object"}
  },
  "description": "Shape contract; runtime validates file hashes, project containment, source and card identities, complete order, crop geometry and scope-bound confirmation. maxItems=50 is a local processing budget, never a WeChat limit."
}
