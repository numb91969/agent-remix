  "userConfig": {
    "TAIHU_TOKEN": {
      "type": "string",
      "label": "太湖 PAT（集团统一鉴权 · 可选）",
      "description": "recruit-mcp 现已支持在 WorkBuddy 直接弹窗连接授权（点「连接」用太湖 SSO 授权即可，无需在此手填）。仅当你的客户端不支持弹窗连接、需手动配置时，才在此填太湖 PAT：https://tai.it.woa.com/user/pat 创建 Personal Access Token，粘贴进来（不要带 Bearer 前缀）。",
      "required": false,
      "sensitive": true
    },
    "TRAG_TOKEN": {
      "type": "string",
      "label": "tRAG PAT（员工 profile 向量库鉴权）",
      "description": "仅用于 requirement-communication-assistant skill 调用 tRAG 检索员工 profile（参照人法 / 内部盘活）。申请：tRAG 控制台 → 个人中心 → PAT 管理（http://api.trag.woa.com）。把 PAT 字符串直接粘贴进来（不要带 Bearer 前缀）。如果不使用'参照人法 / 内部盘活'功能，留空即可。",
      "required": false,
      "sensitive": true
    }
  },
  "mcpServers": {
    "recruit-mcp": {
      "type": "http",
      "url": "https://zhaopin.mcp.it.woa.com",
      "headers": {
        "Authorization": "Bearer ${user_config.TAIHU_TOKEN}"
      },
      "x-workbuddy": {
        "displayName": {
          "en": "Tencent Recruitment",
          "zh": "腾讯招聘"
        },
        "description": {
          "en": "Tencent recruitment platform APIs — resume search, interview arrangement, offer, campus/social recruitment flows, AI outbound call.",
          "zh": "腾讯招聘平台接口——简历搜索、面试安排、offer、校招/社招流程、AI外呼等招聘全链路能力。"
        },
        "auth": {
          "type": "user_config",
          "fields": [
            "TAIHU_TOKEN"
          ]
        }
      }
    },
    "hr_data_service_v1": {
      "type": "http",
      "url": "https://dos-dataview.mcp.it.woa.com/mcp",
      "protocol": "streamable-http",
      "x-workbuddy": {
        "displayName": {
          "en": "HR Data Warehouse",
          "zh": "HR数仓查询"
        },
        "description": {
          "en": "Tencent HR StarRocks data warehouse — query employee info, org structure, movements, performance and more.",
          "zh": "腾讯HR数仓StarRocks查询服务，覆盖员工信息、组织架构、异动、绩效等宽表。"
        },
        "auth": {
          "type": "none"
        }
      }
    }
