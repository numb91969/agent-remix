{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.tencent/recruitment/question-audit-data.schema.json",
  "title": "Question audit task data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "claimed_dimensions",
    "actual_dimensions",
    "checks"
  ],
  "properties": {
    "model_version": {"type": "string", "minLength": 1},
    "claimed_dimensions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "actual_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_accuracy",
        "followup_quality",
        "criteria_clarity",
        "social_desirability_bias"
      ],
      "properties": {
        "assessment_accuracy": {"enum": ["pass", "warn", "fail"]},
        "followup_quality": {"enum": ["pass", "warn", "fail"]},
        "criteria_clarity": {"enum": ["pass", "warn", "fail"]},
        "social_desirability_bias": {"enum": ["pass", "warn", "fail"]}
      }
    },
    "revision_suggestion": {"type": ["string", "null"]}
  }
}
