{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.tencent/recruitment/result-envelope.schema.json",
  "title": "Recruitment controlled task result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "subject_ref",
    "status",
    "data",
    "evidence",
    "missing_evidence",
    "risk_flags",
    "warnings",
    "validation",
    "error",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[A-Za-z0-9._-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^t-[A-Za-z0-9._-]+$"
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "stage", "rubric_version"],
      "properties": {
        "subject_type": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "position_id": {"type": ["string", "null"]},
        "stage": {"type": "string", "minLength": 1},
        "rubric_version": {"type": "string", "minLength": 1}
      }
    },
    "status": {
      "enum": ["success", "partial", "failed", "blocked", "skipped"]
    },
    "data": {"type": "object"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_type", "source_ref", "summary"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": ["resume", "question", "document", "mcp", "script", "user_input", "public_source"]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Use an internal or pseudonymous reference, never a phone, email or identity number."
          },
          "summary": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "risk_flags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "business_rules"],
      "properties": {
        "schema_valid": {"type": "boolean"},
        "business_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "passed"],
            "properties": {
              "rule": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"},
              "detail": {"type": "string"}
            }
          }
        }
      }
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"}
          }
        }
      ]
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "reason", "requires_reroute"],
        "properties": {
          "action": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "requires_reroute": {"const": true}
        }
      }
    }
  }
}
