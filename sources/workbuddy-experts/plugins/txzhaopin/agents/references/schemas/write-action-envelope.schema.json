{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.tencent/recruitment/write-action-envelope.schema.json",
  "title": "Recruitment controlled write action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "action_key",
    "skill",
    "risk_level",
    "side_effect",
    "target_scope",
    "payload_digest",
    "confirmation",
    "idempotency",
    "audit",
    "retry_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "action_id": {
      "type": "string",
      "pattern": "^write-[A-Za-z0-9._-]+$"
    },
    "action_key": {"type": "string", "minLength": 1},
    "skill": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "risk_level": {"const": "R2"},
    "side_effect": {"const": true},
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_count", "target_digest"],
      "properties": {
        "target_type": {"enum": ["candidate_post", "candidate_resume", "interview_trace", "employees"]},
        "target_count": {"type": "integer", "minimum": 1},
        "target_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "payload_digest",
        "confirmed_at",
        "expires_at"
      ],
      "properties": {
        "status": {"const": "confirmed"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "payload_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "confirmed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "backend_deduplication"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^idem-[a-f0-9]{64}$"
        },
        "scope": {"type": "string", "minLength": 1, "maxLength": 200},
        "backend_deduplication": {
          "enum": ["business_dedup_only", "none"]
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ref", "error_code"],
      "properties": {
        "status": {"enum": ["prepared", "submitted", "success", "failed", "unknown"]},
        "ref": {"type": ["string", "null"]},
        "error_code": {"type": ["string", "null"]}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_retry",
        "unknown_outcome",
        "retry_requires_new_confirmation"
      ],
      "properties": {
        "automatic_retry": {"const": false},
        "unknown_outcome": {"const": "do_not_retry_automatically"},
        "retry_requires_new_confirmation": {"const": true}
      }
    }
  }
}
