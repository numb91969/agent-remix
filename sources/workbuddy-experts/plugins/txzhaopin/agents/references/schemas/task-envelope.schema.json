{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.tencent/recruitment/task-envelope.schema.json",
  "title": "Recruitment controlled execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "objective",
    "execution_risk",
    "merge_strategy",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^exec-[A-Za-z0-9._-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "execution_risk": {
      "enum": ["R0", "R1", "R2"]
    },
    "merge_strategy": {
      "enum": ["ordered", "keyed", "ranked", "none"]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "key_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "subjectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id",
        "stage",
        "rubric_version"
      ],
      "properties": {
        "subject_type": {
          "enum": ["candidate", "question", "company", "position", "metric", "document"]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "description": "Use a task-local pseudonymous identifier; do not place names, phones or emails here."
        },
        "position_id": {
          "type": ["string", "null"]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "payload_digest",
        "confirmed_at",
        "expires_at"
      ],
      "properties": {
        "status": {"const": "confirmed"},
        "payload_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "confirmed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "capability",
        "skill",
        "risk_level",
        "subject_scope",
        "action",
        "input_ref",
        "depends_on",
        "side_effect",
        "output_slot",
        "status"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^t-[A-Za-z0-9._-]+$"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "risk_level": {
          "enum": ["R0", "R1", "R2"]
        },
        "subject_scope": {"$ref": "#/$defs/subjectScope"},
        "action": {
          "type": "string",
          "minLength": 1
        },
        "input_ref": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {"type": "string", "pattern": "^t-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "side_effect": {"type": "boolean"},
        "output_slot": {
          "type": "string",
          "pattern": "^results\\.[A-Za-z0-9._-]+$"
        },
        "status": {
          "enum": ["pending", "running", "success", "partial", "failed", "blocked", "skipped"]
        },
        "confirmation": {"$ref": "#/$defs/confirmation"},
        "idempotency_key": {
          "type": "string",
          "minLength": 8
        },
        "audit_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"risk_level": {"const": "R2"}},
            "required": ["risk_level"]
          },
          "then": {
            "properties": {"side_effect": {"const": true}},
            "required": ["confirmation", "idempotency_key", "audit_ref"]
          }
        },
        {
          "if": {
            "properties": {"risk_level": {"enum": ["R0", "R1"]}},
            "required": ["risk_level"]
          },
          "then": {
            "properties": {"side_effect": {"const": false}}
          }
        }
      ]
    }
  }
}
