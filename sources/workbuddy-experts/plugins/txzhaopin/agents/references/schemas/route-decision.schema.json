{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://txzhaopin.local/schemas/route-decision.schema.json",
  "title": "txzhaopin route decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "domain",
    "skill",
    "flow",
    "route_source",
    "coverage",
    "discovery_readiness",
    "fallback_eligibility",
    "fallback_required",
    "owner_skill",
    "alternatives",
    "missing_slots",
    "needs_clarification",
    "clarification_group",
    "risk_level",
    "dependencies"
  ],
  "properties": {
    "intent": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "routing_capabilities 中的精确 intent id"
    },
    "domain": {
      "type": ["string", "null"],
      "enum": [
        "recruitment_core",
        "interview",
        "search",
        "data",
        "channel",
        "brand",
        "automation",
        "internal",
        null
      ]
    },
    "skill": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "flow": {
      "type": ["string", "null"]
    },
    "route_source": {
      "type": "string",
      "enum": ["command", "explicit_skill", "strong_signal", "semantic_rerank", "clarified", "fallback"]
    },
    "coverage": {
      "type": "string",
      "enum": ["full", "partial", "none", "undetermined"],
      "description": "已选业务 Skill 对用户完整目标的覆盖程度"
    },
    "fallback_required": {
      "type": "boolean",
      "description": "是否需要内部 mcp-capability-explorer 补充或发现 recruit-mcp 能力"
    },
    "fallback_eligibility": {
      "type": "string",
      "enum": ["not_needed", "eligible", "awaiting_clarification", "known_unsupported", "ineligible"],
      "description": "是否满足 MCP fallback 的资格；coverage=none 不等于必然可探索"
    },
    "discovery_readiness": {
      "type": "string",
      "enum": ["ready", "needs_clarification", "not_applicable"],
      "description": "进入 SearchAPI 前的执行条件；模糊意图必须先澄清"
    },
    "owner_skill": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "partial 时保持业务流程所有权的 Skill；none 时为 null"
    },
    "alternatives": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "missing_slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_group": {
      "type": ["string", "null"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["R0", "R1", "R2"]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"needs_clarification": {"const": true}},
        "required": ["needs_clarification"]
      },
      "then": {
        "properties": {
          "clarification_group": {"type": "string", "minLength": 1},
          "coverage": {"const": "undetermined"},
          "discovery_readiness": {"const": "needs_clarification"},
          "fallback_eligibility": {"const": "awaiting_clarification"},
          "fallback_required": {"const": false}
        }
      },
      "else": {
        "properties": {
          "clarification_group": {"type": "null"},
          "discovery_readiness": {"enum": ["ready", "not_applicable"]}
        }
      }
    },
    {
      "if": {
        "properties": {"fallback_eligibility": {"const": "awaiting_clarification"}},
        "required": ["fallback_eligibility"]
      },
      "then": {
        "properties": {
          "needs_clarification": {"const": true},
          "coverage": {"const": "undetermined"},
          "discovery_readiness": {"const": "needs_clarification"},
          "fallback_required": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {"coverage": {"const": "full"}},
        "required": ["coverage"]
      },
      "then": {
        "properties": {
          "fallback_required": {"const": false},
          "fallback_eligibility": {"const": "not_needed"},
          "discovery_readiness": {"const": "not_applicable"},
          "owner_skill": {"type": "string", "minLength": 1},
          "intent": {"type": "string", "minLength": 1},
          "domain": {"type": "string"},
          "skill": {"type": "string"}
        }
      }
    },
    {
      "if": {
        "properties": {"coverage": {"const": "partial"}},
        "required": ["coverage"]
      },
      "then": {
        "properties": {
          "fallback_required": {"const": true},
          "fallback_eligibility": {"const": "eligible"},
          "discovery_readiness": {"const": "ready"},
          "owner_skill": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"coverage": {"const": "none"}},
        "required": ["coverage"]
      },
      "then": {
        "properties": {
          "owner_skill": {"type": "null"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"fallback_required": {"const": true}},
              "required": ["fallback_required"]
            },
            "then": {
              "properties": {
                "fallback_eligibility": {"const": "eligible"},
                "discovery_readiness": {"const": "ready"},
                "intent": {"const": "internal.mcp_capability_explorer"},
                "domain": {"const": "internal"},
                "skill": {"const": "mcp-capability-explorer"},
                "route_source": {"const": "fallback"}
              }
            },
            "else": {
              "properties": {
                "fallback_eligibility": {"enum": ["known_unsupported", "ineligible"]},
                "intent": {"type": "null"},
                "domain": {"type": "null"},
                "skill": {"type": "null"}
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {"coverage": {"const": "undetermined"}},
        "required": ["coverage"]
      },
      "then": {
        "properties": {
          "fallback_required": {"const": false},
          "fallback_eligibility": {"const": "awaiting_clarification"},
          "discovery_readiness": {"const": "needs_clarification"},
          "needs_clarification": {"const": true},
          "owner_skill": {"type": "null"},
          "intent": {"type": "null"},
          "domain": {"type": "null"},
          "skill": {"type": "null"}
        }
      }
    }
  ]
}
