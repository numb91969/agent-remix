{
  "runtimeVersion": "26.9.6",
  "platforms": [
    "windows-x64"
  ],
  "entrypoint": "bin/mibao-catalog.py",
  "core": {
    "python": "3.11+ provided by the host",
    "stdlibOnly": true,
    "features": [
      "persistent-catalog",
      "source-locations",
      "incremental-scan",
      "checkpoint-resume",
      "chinese-fts",
      "subtitle-segments",
      "annotations",
      "portable-export",
      "legacy-read",
      "explicit-migration"
    ],
    "multimodalMethodology": "visual-evidence-first",
    "activeModelProfile": null,
    "modelResolution": "runtime-selected-by-active-workspace"
  },
  "managedComponents": [
    {
      "id": "ffmpeg",
      "purpose": "video and audio inspection and conversion",
      "requiredFor": [
        "convert",
        "keyframes",
        "audio-extract"
      ],
      "licenseFile": "runtime/licenses/ffmpeg.txt",
      "status": "runtime-slot"
    },
    {
      "id": "managed-ai-runtime",
      "purpose": "Managed local adapters for OCR, ASR, embeddings, and media enrichment",
      "requiredFor": [
        "ocr",
        "transcribe",
        "embed",
        "enrich"
      ],
      "requirementsFile": "runtime/ai-requirements.txt",
      "setupScript": "runtime/setup_ai_runtime.py",
      "licenseFile": "runtime/licenses/models.txt",
      "status": "setup-on-demand"
    }
  ],
  "policy": {
    "originalsReadOnly": true,
    "outputDirectoryRequired": true,
    "existingOutputOverwriteDisabled": true,
    "symlinkTraversalDisabled": true,
    "arbitraryShellDisabled": true,
    "cloudUploadDefault": false,
    "localAiNetworkInstallDefault": false,
    "userDataOutsidePackage": true
  }
}
