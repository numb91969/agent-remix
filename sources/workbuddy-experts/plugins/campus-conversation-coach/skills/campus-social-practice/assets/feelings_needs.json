{
  "version": "1.0.0",
  "name": "感受与需要词汇表（校园沟通版）",
  "source": "依据 CNVC（Center for Nonviolent Communication）官方免费分发的 Feelings Inventory 与 Needs Inventory 中文化整理，保留出处。官方说明：清单不是穷尽或定论，是自我探索的起点。",
  "needs": {
    "连接": ["亲近", "陪伴", "归属", "被理解", "被看见", "信任", "尊重", "欣赏", "关心", "温暖"],
    "自主": ["选择", "自由", "独立", "空间", "自主决定", "按自己的节奏来"],
    "安全": ["稳定", "秩序", "可预期", "保护", "安心", "确定性"],
    "休息与放松": ["睡眠", "安静", "放松", "从容", "玩乐", "幽默"],
    "意义与成长": ["目标感", "进步", "学习", "贡献", "被需要", "成就感", "挑战"],
    "公平与秩序": ["公平", "一致", "明确的规则", "分工清楚", "守约"],
    "身体健康": ["休息", "饮食", "运动", "舒适的环境"]
  },
  "feelings_when_needs_met": {
    "轻松": ["放松", "安心", "踏实", "平静", "舒展"],
    "愉快": ["开心", "兴奋", "有劲", "期待", "满意", "欣慰"],
    "亲近": ["温暖", "亲近", "被在乎", "感激", "感动"],
    "自信": ["有底气", "笃定", "自豪", "从容", "有掌控感"]
  },
  "feelings_when_needs_unmet": {
    "紧张": ["紧张", "发怵", "没底", "忐忑", "局促", "不自在"],
    "难过": ["失落", "委屈", "沮丧", "孤单", "泄气", "遗憾"],
    "烦躁": ["烦", "恼火", "着急", "不耐烦", "憋屈", "窝火"],
    "疲惫": ["累", "耗竭", "麻木", "提不起劲", "疲惫"],
    "害怕": ["担心", "不安", "害怕", "顾虑", "发慌"]
  },
  "faux_feelings": {
    "note": "以下词听起来像感受，实际是对他人的评判或推断。使用时会变成指责，训练目标是还原为真实感受 + 未满足的需要。",
    "entries": [
      {"faux": "被忽视", "real_feelings": ["失落", "孤单"], "possible_needs": ["被看见", "被在乎"]},
      {"faux": "被针对", "real_feelings": ["委屈", "不安"], "possible_needs": ["公平", "被理解"]},
      {"faux": "被利用", "real_feelings": ["憋屈", "恼火"], "possible_needs": ["尊重", "公平"]},
      {"faux": "被看不起", "real_feelings": ["难过", "沮丧"], "possible_needs": ["尊重", "认可"]},
      {"faux": "被逼", "real_feelings": ["烦躁", "发慌"], "possible_needs": ["自主", "空间"]},
      {"faux": "被冷落", "real_feelings": ["孤单", "失落"], "possible_needs": ["连接", "陪伴"]},
      {"faux": "被误解", "real_feelings": ["委屈", "着急"], "possible_needs": ["被理解"]},
      {"faux": "被控制", "real_feelings": ["憋屈", "恼火"], "possible_needs": ["自主", "选择"]}
    ]
  },
  "usage_rules": [
    "用于冲突与边界表达的准备阶段：帮用户把评判还原为可观察事实、真实感受和具体需要",
    "不要求用户逐句套用，只在用户表达全是评判（他总是/他从不/他就是）时引入",
    "选词以用户本人会说的为准，词汇表是候选池不是填空模板"
  ]
}
